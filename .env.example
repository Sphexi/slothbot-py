# Discord bot token (required)
SB_TOKEN=

# Directory holding limits.json, moderator.json, counter.json and ignored_roles.json.
# Leave unset under Docker: the image sets it to /var/data, which is the mounted volume,
# and env_file would override that and write state outside the volume.
# SB_DATA=data

# debug, info, warning, error
SB_LOG_LEVEL=info

# Sync slash commands to a single guild instead of globally (instant updates, for development)
# SB_GUILD=123456789012345678

# Liveness file the container healthcheck reads; defaults to <SB_DATA>/heartbeat
# SB_HEARTBEAT_FILE=/var/data/heartbeat
